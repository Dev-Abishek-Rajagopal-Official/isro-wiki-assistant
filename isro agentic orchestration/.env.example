# Copy to .env. Never commit .env.

# --- LLM (Azure AI Foundry, OpenAI v1 endpoint)
LLM_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# optional per-role override, roles: ROUTER, RAG_REWRITER, RAG_GENERATOR, LAUNCH_REWRITER, LAUNCH_GENERATOR,
# WIKIDATA_REWRITER, WIKIDATA_GENERATOR, CELESTRAK_REWRITER, CELESTRAK_GENERATOR, FINAL
# MODEL_ROUTER=

# --- Azure Speech (speech-to-text, Fast Transcription)
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
SPEECH_KEY=
SPEECH_LOCALES=en-US,en-IN

# --- PostgreSQL (docker compose up -d) + pgAdmin on http://localhost:5050
POSTGRES_USER=isro
POSTGRES_PASSWORD=change_me
POSTGRES_DB=isro_agent
# standalone runs (examples, tests); the API passes its own database URL to the agent
DATABASE_URL=postgresql://isro:change_me@localhost:5432/isro_orchestrator

# --- MCP servers (isro agent/isromcp, started with run_http_servers.py)
ISROMCP_DIR=../isromcp
MCP_TRANSPORT=http
MAX_HOPS=5
