# Settings for the whole stack (docker-compose.yml). Copy to .env and fill in the Azure values.
# setup.ps1 / setup.sh create .env from this file and generate the local passwords + JWT secret for you.
# .env is git-ignored - never commit real keys.

# ---------------------------------------------------------------- setup behaviour
# true = download / update the Wikipedia articles first (only articles not downloaded yet are fetched).
# false = use the articles already in "wiki documents/" and go straight to building the Qdrant index.
WIKI_DOWNLOAD=false
# contact sent in the User-Agent to Wikipedia / Wikidata (Wikimedia policy): a URL or an email
WIKI_CONTACT=https://github.com/Dev-Abishek-Rajagopal-Official/isro-wiki-assistant
MCP_CONTACT=https://github.com/Dev-Abishek-Rajagopal-Official/isro-wiki-assistant

# ---------------------------------------------------------------- Azure AI Foundry (required)
# Chat model used by every agent role (OpenAI v1-compatible endpoint of the Foundry resource)
LLM_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# optional per-role override, e.g. MODEL_ROUTER=..., MODEL_FINAL=..., MODEL_TITLE=...

# Embeddings for the knowledge base (text-embedding-3-large deployment)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Speech-to-text for voice questions (optional - text chat works without it)
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
SPEECH_KEY=
SPEECH_LOCALES=en-US,en-IN

# ---------------------------------------------------------------- local services (generated by setup)
POSTGRES_USER=isro
POSTGRES_PASSWORD=
POSTGRES_DB=isro_agent
REDIS_PASSWORD=
# at least 32 random characters
JWT_SECRET=
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------------- API
APP_ENV=development
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=7
AGENT_ENABLED=true
MAX_HOPS=5
# admin accounts (comma-separated): reserved from public sign-up, see "Admin account" in README.md
ADMIN_EMAILS=official@abishekrajagopal.com

# ---------------------------------------------------------------- host ports
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
PGADMIN_PORT=5050
