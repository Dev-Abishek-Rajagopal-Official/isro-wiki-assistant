# --- secrets: real keys live only in .env (copy from .env.example) ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / frontend ---
node_modules/
dist/
*.tsbuildinfo
coverage/

# --- local runtime data (rebuilt by docker compose / the ingestion scripts) ---
isro agentic orchestration/pg_data/
isro agentic orchestration/redis_data/
isro agentic orchestration/pgadmin_data/
isro rag/qdrant_storage/
isro rag/qdrant_data/
isro rag/.cache/
isro rag/data/embedding_cache.sqlite
isromcp/.cache/

# --- eval intermediates (regenerated by rag_evals/build_variants.py; results are kept) ---
isro rag/rag_evals/data/variants/

# --- misc ---
*.log
!isro rag/rag_evals/results/*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
