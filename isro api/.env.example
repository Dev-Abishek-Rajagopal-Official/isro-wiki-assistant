# Copy to .env. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://isro:change_me@localhost:5432/isro_agent
REDIS_URL=redis://:change_me@localhost:6379/0
# at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_ENABLED=true
# LLM / Speech / MCP settings are read from ../isro agentic orchestration/.env
# admin accounts (comma-separated); reserved from public sign-up, create with scripts/create_admin.py
ADMIN_EMAILS=official@abishekrajagopal.com
